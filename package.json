{
  "name": "neuronex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NeuroNex — Gestão Inteligente para Psicólogos",
  "author": "NeuroNex",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  },
  "scripts": {
    "dev": "node scripts/start-dev.cjs",
    "dev:web": "vite",
    "dev:voice": "npm run voice:gateway",
    "build": "vite build && node scripts/generate-public-entry-pages.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:frontend-boundaries": "node scripts/check-frontend-boundaries.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:public-entry": "node --test scripts/test-public-entry-pages.mjs",
    "test:deno": "deno test --allow-read --frozen supabase/functions",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run lint && npm run typecheck && npm run check:frontend-boundaries && npm run test && npm run test:public-entry && npm run test:deno && npm run build",
    "voice:gateway": "node scripts/start-voice-gateway-dev.cjs",
    "voice:gateway:raw": "node server/voice-agent-gateway/index.js",
    "voice:gateway:local": "npm run voice:gateway"
  },
