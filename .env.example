# ============================================
# NeuroNex OS - Lean MVP Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# ─── Supabase (Database, Auth, Storage) ──────────────────────
# Required for core functionality
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key is only used for server-side operations (Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Synapse LLM / Voice ─────────────────────────────────────
# Server-side secrets only. Configure these in Supabase Edge Function Secrets.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VOICE_RENDER_MODEL=llama-3.1-8b-instant

# Synapse text chat provider. Current production text path supports nvidia/groq.
SYNAPSE_TEXT_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_SYNAPSE_MODEL=
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Synapse realtime voice. Preferred path: Deepgram Voice Agent + Flux + ElevenLabs pt-BR.
DEEPGRAM_API_KEY=
SYNAPSE_VOICE_PROVIDER=deepgram-agent
VITE_SYNAPSE_VOICE_PROVIDER=deepgram-agent
SYNAPSE_VOICE_GATEWAY_URL=ws://localhost:8080/v1/synapse/voice
PUBLIC_SYNAPSE_VOICE_GATEWAY_URL=ws://localhost:8080/v1/synapse/voice
VITE_SYNAPSE_VOICE_GATEWAY_URL=ws://localhost:8080/v1/synapse/voice
SYNAPSE_VOICE_GATEWAY_SECRET=
SYNAPSE_VOICE_GATEWAY_PORT=8789
SYNAPSE_VOICE_INPUT_SAMPLE_RATE=16000
SYNAPSE_VOICE_OUTPUT_SAMPLE_RATE=24000
VITE_SYNAPSE_VOICE_FRAME_MS=20
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_LISTEN_MODEL=flux-general-multi
DEEPGRAM_LISTEN_LANGUAGE=pt-BR
DEEPGRAM_EOT_THRESHOLD=0.72
DEEPGRAM_EAGER_EOT_THRESHOLD=0.45
DEEPGRAM_EOT_TIMEOUT_MS=1200
DEEPGRAM_THINK_PROVIDER=nvidia
# Deepgram-managed NVIDIA model ID. The gateway also normalizes nvidia/nemotron-3-nano-30b-a3b to this value.
DEEPGRAM_THINK_MODEL=nemotron-3-nano-30B-A3B
DEEPGRAM_THINK_TEMPERATURE=0.35
SYNAPSE_VOICE_TTS_PROVIDER=deepgram-elevenlabs
DEEPGRAM_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
DEEPGRAM_ELEVENLABS_VOICE_ID=UgBBYS2sOqTuMpoF3BR0
DEEPGRAM_ELEVENLABS_LANGUAGE_CODE=pt-BR
SYNAPSE_VOICE_SLOW_FUNCTION_MS=5500
SYNAPSE_VOICE_FOLLOWUP_FUNCTION_MS=9000
SYNAPSE_VOICE_TOOL_TIMEOUT_MS=18000
SYNAPSE_VOICE_MAX_TOOL_RETRIES=1
# Optional raw speak.provider override for Deepgram-managed/account-enabled TTS.
# Do not add ElevenLabs API keys here; the voice stack authenticates with DEEPGRAM_API_KEY only.
SYNAPSE_VOICE_SPEAK_PROVIDER_JSON=
DEEPGRAM_MANAGED_CARTESIA=true
DEEPGRAM_ENABLE_AURA_FALLBACK=false
CARTESIA_MODEL_ID=sonic-2
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=pt-BR
CARTESIA_SPEED=normal
CARTESIA_VOLUME=1
CARTESIA_API_KEY=

# Legacy/cascade voice rollback. Disabled by default; enable only for diagnostics or emergency rollback.
# To force it, set both SYNAPSE_VOICE_PROVIDER and VITE_SYNAPSE_VOICE_PROVIDER to legacy-cascade too.
SYNAPSE_ENABLE_LEGACY_CASCADE=false
VITE_SYNAPSE_LEGACY_CASCADE_ENABLED=false
VITE_SYNAPSE_LEGACY_CASCADE_CLOUD_STT=false
SYNAPSE_LEGACY_CASCADE_ALLOW_GROQ_STT=false
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=pt-BR
DEEPGRAM_STT_FILLER_WORDS=false
VITE_SYNAPSE_VOICE_NOISE_SUPPRESSION=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# Optional: the legacy Azure renderer automatically tries compatible pt-BR voices if omitted.
AZURE_SPEECH_VOICE=pt-BR-ThalitaMultilingualNeural

# Optional additional model providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ─── Financial Providers (Asaas BaaS v3) ─────────────────────
ASAAS_API_KEY=
ASAAS_API_URL=https://www.asaas.com/api/v3

# ─── Automation & Workflows (N8N) ───────────────────────────
N8N_API_KEY=
N8N_WEBHOOK_URL=

# NeuroZap / WhatsApp Business white-label
# Server-side secrets only. Configure these in Supabase Edge Function Secrets.
EVOLUTION_API_URL=https://wsapi.neuronexai.com.br
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_WEBHOOK_MODE=sandbox
EVOLUTION_WEBHOOK_SANDBOX_BASE=https://wsapi.neuronexai.com.br/webhook-test
EVOLUTION_WEBHOOK_PRODUCTION_BASE=https://wsapi.neuronexai.com.br/webhook
SYNAPSE_CHANNEL_SECRET=
SYNAPSE_INTERNAL_SECRET=

# ─── Monitoring & CI/CD ─────────────────────────────────────
SENTRY_DSN=
GITHUB_TOKEN=

# ─── Core Configuration ─────────────────────────────────────
NODE_ENV=development
VITE_APP_VERSION=2.1.0-lean-mvp
