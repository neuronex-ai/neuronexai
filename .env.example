# ============================================
# NeuroNex OS - Lean MVP Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# ─── Supabase (Database, Auth, Storage) ──────────────────────
# Required for core functionality
VITE_SUPABASE_URL=https://krewdaklcyzqfxkkgvqr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_4KskQwuXcYnvPJEYS_df2g_pcTmbXjo
# Service role key is only used for server-side operations (Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Synapse LLM / Voice ─────────────────────────────────────
# Server-side secrets only. Configure these in Supabase Edge Function Secrets.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VOICE_RENDER_MODEL=llama-3.1-8b-instant

# Synapse text chat provider. Current production text path supports nvidia/groq.
SYNAPSE_TEXT_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_SYNAPSE_MODEL=
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Synapse realtime voice. Single supported path: Deepgram Voice Agent + ElevenLabs.
# Local dev proxies the same-origin websocket route /v1/synapse/voice to the
# canonical Supabase Edge gateway so provider validation cannot drift locally.
DEEPGRAM_API_KEY=
NVIDIA_VOICE_API_KEY=
ELEVENLABS_API_KEY=
# Alias accepted for existing Supabase Edge Function secrets.
ELEVEN_LABS_API_KEY=
# Optional production override returned by the Edge Function. Leave empty for localhost.
SYNAPSE_VOICE_GATEWAY_URL=
PUBLIC_SYNAPSE_VOICE_GATEWAY_URL=
# Optional explicit upstream used only by the local Edge-gateway proxy.
SYNAPSE_VOICE_REMOTE_GATEWAY_URL=
SYNAPSE_VOICE_GATEWAY_SECRET=
SYNAPSE_VOICE_GATEWAY_PORT=8789
SYNAPSE_VOICE_INPUT_SAMPLE_RATE=48000
SYNAPSE_VOICE_OUTPUT_SAMPLE_RATE=24000
VITE_SYNAPSE_VOICE_FRAME_MS=20
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_LISTEN_MODEL=flux-general-multi
DEEPGRAM_LISTEN_LANGUAGE=pt-BR
DEEPGRAM_EOT_THRESHOLD=0.72
DEEPGRAM_EAGER_EOT_THRESHOLD=0.45
DEEPGRAM_EOT_TIMEOUT_MS=1200
# Single active Synapse voice LLM path. Keep server-side only.
# Default: Deepgram Voice Agent -> OpenAI-compatible NVIDIA endpoint -> nvidia/nemotron-3-nano-30b-a3b.
SYNAPSE_VOICE_LLM_PROVIDER_TYPE=open_ai
SYNAPSE_VOICE_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
SYNAPSE_VOICE_LLM_ENDPOINT_URL=https://integrate.api.nvidia.com/v1/chat/completions
SYNAPSE_VOICE_LLM_API_KEY=
SYNAPSE_VOICE_NVIDIA_THINKING=off
SYNAPSE_VOICE_THINK_TEMPERATURE=
SYNAPSE_VOICE_ENABLE_REASONING_EFFORT=false
SYNAPSE_VOICE_TTS_PROVIDER=deepgram-elevenlabs
# TTS model is pinned server-side to ElevenLabs eleven_turbo_v2_5.
# Deepgram multilingual mode is emitted as provider.language="multi".
# Optional preferred voice ID. The runtime verifies it against /v2/voices using
# the configured ElevenLabs API key. If inaccessible, it selects an accessible
# English voice from the account rather than forwarding a dead voice ID.
SYNAPSE_VOICE_TTS_PT_BR_VOICE_ID=
SYNAPSE_VOICE_SLOW_FUNCTION_MS=5500
SYNAPSE_VOICE_FOLLOWUP_FUNCTION_MS=9000
SYNAPSE_VOICE_TOOL_TIMEOUT_MS=18000
SYNAPSE_VOICE_MAX_TOOL_RETRIES=1
VITE_SYNAPSE_VOICE_NOISE_SUPPRESSION=false

# Optional additional model providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ─── Financial Providers (Asaas BaaS v3) ─────────────────────
ASAAS_API_KEY=
ASAAS_API_URL=https://www.asaas.com/api/v3

# ─── Automation & Workflows (N8N) ────────────────────────────
N8N_API_KEY=
N8N_WEBHOOK_URL=

# NeuroZap / WhatsApp Business white-label
# Server-side secrets only. Configure these in Supabase Edge Function Secrets.
EVOLUTION_API_URL=https://wsapi.neuronexai.com.br
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_WEBHOOK_MODE=sandbox
EVOLUTION_WEBHOOK_SANDBOX_BASE=https://wsapi.neuronexai.com.br/webhook-test
EVOLUTION_WEBHOOK_PRODUCTION_BASE=https://wsapi.neuronexai.com.br/webhook
SYNAPSE_CHANNEL_SECRET=
SYNAPSE_INTERNAL_SECRET=

# ─── Monitoring & CI/CD ──────────────────────────────────────
SENTRY_DSN=
GITHUB_TOKEN=

# ─── Core Configuration ──────────────────────────────────────
NODE_ENV=development
VITE_APP_VERSION=2.1.0-lean-mvp
